#!/usr/bin/env bash

set -Eeuo pipefail

readonly VERSION_FILE='/usr/share/cambonos-installer/version'
PACKAGE_VERSION='development'
if [[ -r "$VERSION_FILE" ]]; then
	PACKAGE_VERSION=$(<"$VERSION_FILE")
fi
readonly TITLE=" CambonOS Installer ${PACKAGE_VERSION} "
readonly MOUNT_POINT='/mnt'

WORK_DIR=''
KEEP_WORK_DIR=0
DISK=''
MODE=''
BOOT_MODE=''
EFI_PARTITION=''
ROOT_PARTITION=''
EFI_LABEL=''
ROOT_LABEL=''
HOSTNAME=''
ADMIN_USER=''
ADMIN_NAME=''
ADMIN_PASSWORD=''
DESKTOP=''
DESKTOP_REPOSITORY=''
INSTALL_SSH='no'
LOCALE=''
TIMEZONE=''
XKB_LAYOUT=''
VCONSOLE_KEYMAP=''
AUTO_UPDATES='no'
GPU=''

usage() {
	cat <<'EOF'
Uso: cambonos-installer [--help]

Inicia el instalador interactivo de CambonOS. Debe ejecutarse como root desde
el sistema live de CambonOS.
EOF
}

show_message() {
	local message=$1
	dialog --title "$TITLE" --msgbox "\n$message" 0 0
}

show_error() {
	local message=$1
	if command -v dialog >/dev/null 2>&1 && [[ -t 0 && -t 1 ]]; then
		show_message "$message" || true
	else
		printf '%s\n' "$message" >&2
	fi
}

cleanup() {
	local exit_code=$?
	if mountpoint -q "$MOUNT_POINT"; then
		umount -R "$MOUNT_POINT" || true
	fi
	if [[ "$KEEP_WORK_DIR" -eq 0 && -n "$WORK_DIR" && -d "$WORK_DIR" ]]; then
		rm -rf -- "$WORK_DIR"
	fi
	exit "$exit_code"
}

fail() {
	show_error "$1"
	exit 1
}

require_commands() {
	local missing=()
	local command_name
	for command_name in "$@"; do
		command -v "$command_name" >/dev/null 2>&1 || missing+=("$command_name")
	done
	if ((${#missing[@]})); then
		fail "Faltan comandos necesarios: ${missing[*]}"
	fi
}

dialog_input() {
	dialog --stdout --title "$TITLE" "$@"
}

prepare_network() {
	local failed_network_checks=0
	systemctl start NetworkManager.service >/dev/null 2>&1 || true
	sleep 2
	while true; do
		dialog --title "$TITLE" --sleep 1 --infobox '\nChecking Arch Linux mirror connection...' 5 72 || true
		if curl --fail --silent --show-error --head --connect-timeout 5 --max-time 10 'https://geo.mirror.pkgbuild.com/core/os/x86_64/core.db' >/dev/null 2>&1; then
			return 0
		fi
		((failed_network_checks += 1))
		if ((failed_network_checks >= 5)); then
			show_message 'Network is still unavailable. Configure it with nmtui.' || true
			nmtui || true
			failed_network_checks=0
		fi
	done
}

update_installer() {
	local update_dir update_pid update_status=0
	if ! update_dir=$(mktemp -d); then
		show_error 'No se pudo preparar el directorio temporal de la actualización.'
		return 1
	fi
	if ! mkfifo "$update_dir/pacman-output"; then
		rmdir -- "$update_dir"
		show_error 'No se pudo preparar la salida de la actualización.'
		return 1
	fi
	pacman -Sy --noconfirm cambonos-installer >"$update_dir/pacman-output" 2>&1 &
	update_pid=$!
	dialog --title "$TITLE" --programbox '\nUpdating CambonOS installer...' 20 76 < "$update_dir/pacman-output" || true
	wait "$update_pid" || update_status=$?
	rm -f -- "$update_dir/pacman-output"
	rmdir -- "$update_dir"
	if ((update_status != 0)); then
		show_error 'No se pudo actualizar cambonos-installer desde el repositorio de CambonOS.'
	fi
	return "$update_status"
}

prepare_installer() {
	if [[ ${CAMBONOS_INSTALLER_UPDATED:-} == 1 ]]; then
		unset CAMBONOS_INSTALLER_UPDATED
		return 0
	fi
	prepare_network
	update_installer || return $?
	CAMBONOS_INSTALLER_UPDATED=1 exec /usr/bin/cambonos-installer "$@"
}

normalize_admin_user() {
	local username=${1,,}
	username=${username// /-}
	printf '%s' "$username"
}

valid_admin_user() {
	[[ ${#1} -le 32 && "$1" =~ ^[a-z_][a-z0-9_-]*$ ]]
}

password_meets_requirements() {
	local password=$1
	[[ ${#password} -ge 8 && "$password" =~ [a-z] && "$password" =~ [A-Z] && \
		"$password" =~ [0-9] && "$password" =~ [^a-zA-Z0-9[:space:]] ]]
}

choose_disk() {
	local device size model
	local -a disks=() options=()
	mapfile -t disks < <(lsblk -dnpo NAME,TYPE | awk '$2 == "disk" { print $1 }')
	((${#disks[@]})) || fail 'No se detectaron discos de destino.'

	for device in "${disks[@]}"; do
		size=$(lsblk -dno SIZE "$device")
		model=$(lsblk -dno MODEL "$device" | sed 's/[[:space:]]*$//')
		[[ -n "$model" ]] || model='Sin modelo'
		options+=("$device" "$size | $model")
	done

	DISK=$(dialog_input --menu '\nSeleccione el disco de destino:' 16 84 8 "${options[@]}") || return 1
}

choose_locale() {
	local locale
	local -a locales=() options=()
	[[ -r /usr/share/i18n/SUPPORTED ]] || fail 'No se encuentra la lista de locales disponibles.'
	mapfile -t locales < <(awk '$1 ~ /\.UTF-8$/ { print $1 }' /usr/share/i18n/SUPPORTED | sort -u)
	((${#locales[@]})) || fail 'No se encontraron locales UTF-8 disponibles.'
	for locale in "${locales[@]}"; do
		options+=("$locale" "$locale")
	done
	LOCALE=$(dialog_input --menu '\nSeleccione el idioma y la región:' 20 84 12 "${options[@]}") || return 1
}

choose_timezone() {
	local timezone
	local -a timezones=() options=()
	mapfile -t timezones < <(timedatectl list-timezones)
	((${#timezones[@]})) || fail 'No se encontraron zonas horarias disponibles.'
	for timezone in "${timezones[@]}"; do
		options+=("$timezone" "$timezone")
	done
	TIMEZONE=$(dialog_input --menu '\nSeleccione la zona horaria:' 20 84 12 "${options[@]}") || return 1
}

choose_keyboard() {
	local label xkb_layout keymap
	local -a available_keymaps=() options=()
	mapfile -t available_keymaps < <(localectl list-keymaps)
	while IFS='|' read -r label xkb_layout keymap; do
		if printf '%s\n' "${available_keymaps[@]}" | grep -Fxq "$keymap"; then
			options+=("$xkb_layout" "$label")
		fi
	done <<'EOF'
Español|es|es
Latinoamericano|latam|la-latin1
Inglés (Estados Unidos)|us|us
Inglés (Reino Unido)|gb|uk
Francés|fr|fr
Alemán|de|de-latin1
Italiano|it|it
Portugués|pt|pt-latin1
EOF
	((${#options[@]})) || fail 'No se encontraron distribuciones de teclado compatibles.'
	XKB_LAYOUT=$(dialog_input --menu '\nSeleccione la distribución del teclado:' 16 76 8 "${options[@]}") || return 1
	case "$XKB_LAYOUT" in
		es) VCONSOLE_KEYMAP='es' ;;
		latam) VCONSOLE_KEYMAP='la-latin1' ;;
		us) VCONSOLE_KEYMAP='us' ;;
		gb) VCONSOLE_KEYMAP='uk' ;;
		fr) VCONSOLE_KEYMAP='fr' ;;
		de) VCONSOLE_KEYMAP='de-latin1' ;;
		it) VCONSOLE_KEYMAP='it' ;;
		pt) VCONSOLE_KEYMAP='pt-latin1' ;;
		*) return 1 ;;
	esac
}

collect_options() {
	local value password_confirmation
	local -a desktops

	while true; do
		HOSTNAME=$(dialog_input --inputbox '\nNombre del equipo:' 9 72) || return 1
		HOSTNAME=${HOSTNAME,,}
		if [[ "$HOSTNAME" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; then
			break
		fi
		show_message 'El nombre debe tener hasta 63 caracteres, usar letras minúsculas, números o guiones y no empezar ni terminar con guion.'
	done

	while true; do
		ADMIN_NAME=$(dialog_input --inputbox '\nNombre del usuario (se usará también para iniciar sesión):' 9 72 'Administrador') || return 1
		ADMIN_USER=$(normalize_admin_user "$ADMIN_NAME")
		if valid_admin_user "$ADMIN_USER"; then
			break
		fi
		show_message 'El nombre debe generar un usuario Linux válido de hasta 32 caracteres: letras, números, guiones o guiones bajos; no puede empezar por guion. Los espacios se convierten en guiones.'
	done

	while true; do
		ADMIN_PASSWORD=$(dialog_input --passwordbox '\nContraseña del usuario:' 9 72) || return 1
		password_confirmation=$(dialog_input --passwordbox '\nRepetir contraseña:' 9 72) || return 1
		if [[ "$ADMIN_PASSWORD" != "$password_confirmation" ]]; then
			unset password_confirmation
			show_message 'Las contraseñas no coinciden. Inténtelo de nuevo.'
		elif ! password_meets_requirements "$ADMIN_PASSWORD"; then
			unset password_confirmation
			show_message 'La contraseña debe tener al menos 8 caracteres e incluir una minúscula, una mayúscula, un número y un símbolo (no cuentan los espacios).'
		else
			unset password_confirmation
			break
		fi
	done

	choose_locale || return 1
	choose_timezone || return 1
	choose_keyboard || return 1

	desktops=(1 'Cambon18/XFCE (Recomendado)' 2 'Cambon18/Qtile' 3 'CambonOS/XFCE')
	value=$(dialog_input --menu '\nSeleccione el entorno de escritorio:' 12 76 4 "${desktops[@]}") || return 1
	case "$value" in
		1) DESKTOP='xfce' ;;
		2) DESKTOP='qtile' ;;
		3) DESKTOP='cambonos-xfce' ;;
		*) return 1 ;;
	esac

	if dialog --title "$TITLE" --yesno '\n¿Desea instalar el servidor SSH?' 7 72; then
		INSTALL_SSH='yes'
	else
		INSTALL_SSH='no'
	fi
	if dialog --title "$TITLE" --yesno '\n¿Desea instalar actualizaciones automáticas del sistema?' 7 76; then
		AUTO_UPDATES='yes'
	else
		AUTO_UPDATES='no'
	fi

	value=$(dialog_input --menu '\nModo de instalación:' 12 76 4 \
		clean 'Instalación limpia: borra el disco seleccionado' \
		free 'Instalar en espacio libre de un disco GPT (UEFI)') || return 1
	case "$value" in
		clean) MODE='clean' ;;
		free) MODE='free' ;;
		*) return 1 ;;
	esac

	choose_disk || return 1
	if [[ "$MODE" == 'free' ]]; then
		[[ -d /sys/firmware/efi/efivars ]] || fail 'La instalación en espacio libre requiere iniciar el sistema live en modo UEFI.'
		BOOT_MODE='uefi'
	else
		if [[ -d /sys/firmware/efi/efivars ]]; then
			BOOT_MODE='uefi'
		else
			BOOT_MODE='bios'
		fi
	fi

	local confirmation
	confirmation="Equipo: $HOSTNAME\nUsuario: $ADMIN_USER\nIdioma: $LOCALE\nZona horaria: $TIMEZONE\nTeclado: $XKB_LAYOUT\nEscritorio: $DESKTOP\nServidor SSH: $INSTALL_SSH\nActualizaciones automáticas: $AUTO_UPDATES\nModo: $MODE\nArranque: $BOOT_MODE\nDisco: $DISK\n\n"
	if [[ "$MODE" == 'clean' ]]; then
		confirmation+="ATENCIÓN: se borrarán todas las particiones y los datos del disco.\n\n"
	fi
	confirmation+='¿Desea comenzar la instalación?'
	dialog --title "$TITLE" --yesno "\n$confirmation" 18 84 || return 1
}

check_desktop_source() {
	local desktop_root=${1:-/root}

	if [[ "$DESKTOP" != 'cambonos-xfce' ]]; then
		[[ -f "$desktop_root/$DESKTOP/archie.sh" ]] || fail "No se encuentra $desktop_root/$DESKTOP/archie.sh en el sistema live."
		return 0
	fi

	DESKTOP_REPOSITORY=$(pacman -Sp --nodeps --print-format '%r' cambonos-pacman) || fail 'No se pudo determinar el canal de CambonOS para el sistema de destino.'
	case "$DESKTOP_REPOSITORY" in
		cambonos|cambonos-testing) ;;
		*) fail 'No se pudo determinar el canal de CambonOS para el sistema de destino.' ;;
	esac
	pacman -Si "$DESKTOP_REPOSITORY/cambonos-xfce" >/dev/null || fail "El paquete cambonos-xfce no está disponible en $DESKTOP_REPOSITORY."
}

check_optional_upgrade_package() {
	[[ "$AUTO_UPDATES" == 'yes' ]] || return 0
	pacman -Si cambonos-upgrade >/dev/null || fail 'El paquete cambonos-upgrade no está disponible en el canal configurado.'
}

find_free_region() {
	local output
	output=$(parted -sm "$DISK" unit MiB print free) || fail 'No se pudo leer la tabla de particiones.'
	[[ "$(awk -F: 'NR == 2 { print $6 }' <<< "$output")" == 'gpt' ]] || fail 'El modo de espacio libre solo admite discos con tabla GPT.'

	local region
	region=$(awk -F: '
		$NF ~ /free/ {
			start = $2
			end = $3
			sub(/MiB.*/, "", start)
			sub(/MiB.*/, "", end)
			size = end - start
			if (size >= largest) {
				largest = size
				free_start = start
				free_end = end
			}
		}
		END {
			if (largest >= 25600) {
				printf "%.3f %.3f", free_start, free_end
			}
		}
	' <<< "$output")
	[[ -n "$region" ]] || fail 'No se encontró un espacio libre contiguo suficiente para una raíz de 24 GiB y una partición EFI de 1 GiB.'
	read -r FREE_START FREE_END <<< "$region"
}

create_partitions() {
	local efi_end part label type attempt efi_count root_count
	EFI_PARTITION=''
	ROOT_PARTITION=''
	EFI_LABEL="CambonOS-EFI-${BASHPID}"
	ROOT_LABEL="CambonOS-root-${BASHPID}"

	if [[ "$MODE" == 'clean' ]]; then
		parted -s -a optimal "$DISK" mklabel gpt
		if [[ "$BOOT_MODE" == 'uefi' ]]; then
			parted -s -a optimal "$DISK" mkpart "$EFI_LABEL" fat32 1MiB 1025MiB
			parted -s "$DISK" set 1 esp on
			parted -s -a optimal "$DISK" mkpart "$ROOT_LABEL" ext4 1025MiB 100%
		else
			parted -s -a optimal "$DISK" mkpart "CambonOS-BIOS-${BASHPID}" 1MiB 3MiB
			parted -s "$DISK" set 1 bios_grub on
			parted -s -a optimal "$DISK" mkpart "$ROOT_LABEL" ext4 3MiB 100%
		fi
	else
		find_free_region
		efi_end=$(awk -v start="$FREE_START" 'BEGIN { printf "%.3f", start + 1024 }')
		parted -s -a optimal "$DISK" mkpart "$EFI_LABEL" fat32 "${FREE_START}MiB" "${efi_end}MiB"
		parted -s -a optimal "$DISK" mkpart "$ROOT_LABEL" ext4 "${efi_end}MiB" "${FREE_END}MiB"
	fi

	partprobe "$DISK"
	udevadm settle
	for attempt in {1..10}; do
		EFI_PARTITION=''
		ROOT_PARTITION=''
		efi_count=0
		root_count=0
		while read -r part label type; do
			[[ "$type" == 'part' ]] || continue
			if [[ "$label" == "$EFI_LABEL" ]]; then
				EFI_PARTITION=$part
				((efi_count += 1))
			fi
			if [[ "$label" == "$ROOT_LABEL" ]]; then
				ROOT_PARTITION=$part
				((root_count += 1))
			fi
		done < <(lsblk -lnpo NAME,PARTLABEL,TYPE "$DISK")
		((efi_count <= 1 && root_count <= 1)) || fail 'Las etiquetas de las particiones recién creadas no son únicas.'
		if [[ -n "$ROOT_PARTITION" && ( "$BOOT_MODE" != 'uefi' || -n "$EFI_PARTITION" ) ]]; then
			break
		fi
		udevadm settle
		sleep 1
	done
	[[ -n "$ROOT_PARTITION" ]] || fail 'No se pudo identificar la partición raíz recién creada.'
	if [[ "$BOOT_MODE" == 'uefi' ]]; then
		[[ -n "$EFI_PARTITION" ]] || fail 'No se pudo identificar la partición EFI recién creada.'
	fi
	if [[ "$MODE" == 'free' ]]; then
		local root_size
		part=$(lsblk -dnro PARTN "$EFI_PARTITION")
		[[ "$part" =~ ^[0-9]+$ ]] || fail 'No se pudo identificar el número de la nueva partición EFI.'
		parted -s "$DISK" set "$part" esp on
		partprobe "$DISK"
		udevadm settle
		root_size=$(lsblk -bno SIZE "$ROOT_PARTITION")
		((root_size >= 24 * 1024 * 1024 * 1024)) || fail 'La partición raíz del espacio libre debe tener al menos 24 GiB.'
	fi
}

progress() {
	local percent=$1 message=$2
	((percent < PROGRESS_PERCENT)) && percent=$PROGRESS_PERCENT
	PROGRESS_PERCENT=$percent
	printf 'XXX\n%s\n\\n%s\nXXX\n' "$percent" "$message" >&3
}

PROGRESS_PERCENT=0

run_chroot() {
	arch-chroot "$MOUNT_POINT" "$@"
}

install_yay_and_optional_optimus_manager() {
	run_chroot su -s /bin/bash updates -c 'cd /tmp && git clone https://aur.archlinux.org/yay.git && cd yay && makepkg --noconfirm -si'
	if [[ "$GPU" == 'nvidia-hybrid' ]]; then
		run_chroot su -s /bin/bash updates -c 'yay --noconfirm -S optimus-manager optimus-manager-qt'
	fi
}

uefi_boot_entry_details() {
	local line=$1 normalized entry_number
	normalized=${line,,}
	[[ "$line" =~ ^Boot([[:xdigit:]]{4})\*?[[:space:]]CambonOS[[:space:]] ]] || return 1
	entry_number=${BASH_REMATCH[1]}
	[[ "$normalized" == *'/file(\efi\cambonos\grubx64.efi)'* ]] || return 1
	[[ "$normalized" =~ hd\([0-9]+,gpt,([[:xdigit:]-]+), ]] || return 1
	printf '%s %s\n' "$entry_number" "${BASH_REMATCH[1]}"
}

ensure_uefi_boot_entry() {
	local mount_point=${1:-$MOUNT_POINT}
	local partition_number partuuid boot_entries line details entry_number entry_partuuid
	local valid_entry=0
	local -a old_entries=()
	partition_number=$(lsblk -no PARTN "$EFI_PARTITION")
	partuuid=$(blkid -s PARTUUID -o value "$EFI_PARTITION")
	[[ -n "$partition_number" && -n "$partuuid" ]] || return 1
	[[ -f "$mount_point/boot/EFI/CambonOS/grubx64.efi" ]] || return 1
	partuuid=${partuuid,,}
	boot_entries=$(run_chroot efibootmgr -v)
	while IFS= read -r line; do
		details=$(uefi_boot_entry_details "$line") || continue
		read -r entry_number entry_partuuid <<< "$details"
		if [[ "${entry_partuuid,,}" == "$partuuid" ]]; then
			valid_entry=1
		else
			old_entries+=("$entry_number")
		fi
	done <<< "$boot_entries"
	for entry_number in "${old_entries[@]}"; do
		run_chroot efibootmgr --bootnum "$entry_number" --delete-bootnum
	done
	if [[ "$valid_entry" -eq 0 ]]; then
		run_chroot efibootmgr --create --disk "$DISK" --part "$partition_number" --label CambonOS --loader '\EFI\CambonOS\grubx64.efi'
	fi
	boot_entries=$(run_chroot efibootmgr -v)
	while IFS= read -r line; do
		details=$(uefi_boot_entry_details "$line") || continue
		read -r entry_number entry_partuuid <<< "$details"
		[[ "${entry_partuuid,,}" == "$partuuid" ]] && return 0
	done <<< "$boot_entries"
	return 1
}

install_base_system() {
	local -a base_packages system_packages cpu_packages extra_packages gpu_packages

	progress 9 'Sincronizando la hora y seleccionando mirrors'
	timedatectl set-ntp true
	reflector -l 10 -f 5 --save /etc/pacman.d/mirrorlist
	progress 11 'Actualizando las claves de Arch Linux'
	pacman --noconfirm -Sy archlinux-keyring

	base_packages=(base linux linux-firmware cambonos-keyring cambonos-pacman)
	system_packages=(linux-headers lsb-release tree htop xclip micro vim man man-db man-pages man-pages-es bash-completion networkmanager ntp systemd-resolvconf git wget base-devel sudo ntfs-3g dosfstools exfatprogs cpupower rsync accountsservice cambonos-base cambonos-plymouth cambonos-grub zsh iptables avahi)
	if grep -q 'Intel' /proc/cpuinfo; then
		cpu_packages=(intel-ucode)
	elif grep -q 'AMD' /proc/cpuinfo; then
		cpu_packages=(amd-ucode)
	else
		cpu_packages=(amd-ucode intel-ucode)
	fi
	if [[ "$BOOT_MODE" == 'uefi' ]]; then
		system_packages+=(efibootmgr)
	fi
	progress 13 'Instalando el sistema base'
	pacstrap "$MOUNT_POINT" "${base_packages[@]}"
	progress 22 'Detectando hardware y preparando controladores'

	if ! grep -q '^\[multilib\]' "$MOUNT_POINT/etc/pacman.conf"; then
		printf '\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' >> "$MOUNT_POINT/etc/pacman.conf"
	fi

	GPU=$(lspci | grep -E 'VGA|3D' | grep -oE 'NVIDIA|AMD|Intel' | head -n1 | tr '[:upper:]' '[:lower:]' || true)
	if lspci | grep -E 'VGA|3D' | grep -q 'NVIDIA' && lspci | grep -q 'Intel'; then
		GPU='nvidia-hybrid'
	fi
	case "$GPU" in
		amd) gpu_packages=(mesa lib32-mesa vulkan-radeon lib32-vulkan-radeon vulkan-icd-loader lib32-vulkan-icd-loader) ;;
		nvidia|nvidia-hybrid) gpu_packages=(nvidia-open nvidia-utils lib32-nvidia-utils nvidia-settings vulkan-icd-loader lib32-vulkan-icd-loader) ;;
		intel) gpu_packages=(mesa lib32-mesa vulkan-intel lib32-vulkan-intel vulkan-icd-loader lib32-vulkan-icd-loader) ;;
		*) gpu_packages=(mesa lib32-mesa vulkan-icd-loader lib32-vulkan-icd-loader) ;;
	esac
	extra_packages=(xdg-user-dirs libpwquality)
	if [[ "$INSTALL_SSH" == 'yes' ]]; then
		extra_packages+=(openssh)
	fi
	progress 25 'Instalando paquetes del sistema y controladores'
	run_chroot pacman -Syu --noconfirm "${system_packages[@]}" "${cpu_packages[@]}" "${gpu_packages[@]}" "${extra_packages[@]}"
	progress 36 'Paquetes del sistema instalados'
}

install_desktop() {
	local mount_point=${1:-$MOUNT_POINT}
	local desktop_source="/root/$DESKTOP"

	if [[ "$DESKTOP" == 'cambonos-xfce' ]]; then
		run_chroot pacman -Syu --noconfirm "$DESKTOP_REPOSITORY/cambonos-xfce"
		install -d "$mount_point/etc/lightdm/lightdm.conf.d"
		printf '[Seat:*]\nuser-session=cambonos-xfce\n' > "$mount_point/etc/lightdm/lightdm.conf.d/60-cambonos-xfce-session.conf"
	else
		cp -a "$desktop_source" "$mount_point/$DESKTOP"
		run_chroot chown -R updates:updates "/$DESKTOP"
		run_chroot su -s /bin/bash updates -c "cd /$DESKTOP && bash archie.sh"
		rm -rf -- "$mount_point/$DESKTOP"
	fi
}

configure_localization() {
	local mount_point=${1:-$MOUNT_POINT}
	printf 'LANG=%s\nLANGUAGE=%s\nLC_ALL=%s\n' "$LOCALE" "$LOCALE" "$LOCALE" > "$mount_point/etc/locale.conf"
	{
		printf '%s UTF-8\n' "$LOCALE"
		[[ "$LOCALE" == 'en_US.UTF-8' ]] || printf 'en_US.UTF-8 UTF-8\n'
	} > "$mount_point/etc/locale.gen"
	printf 'KEYMAP=%s\n' "$VCONSOLE_KEYMAP" > "$mount_point/etc/vconsole.conf"
	install -d "$mount_point/etc/X11/xorg.conf.d"
	cat > "$mount_point/etc/X11/xorg.conf.d/00-keyboard.conf" <<EOF
Section "InputClass"
        Identifier "system-keyboard"
        MatchIsKeyboard "on"
        Option "XkbLayout" "$XKB_LAYOUT"
EndSection
EOF
	run_chroot ln -sf "/usr/share/zoneinfo/$TIMEZONE" /etc/localtime
	run_chroot hwclock --systohc
	run_chroot locale-gen
}

install_optional_upgrade_package() {
	[[ "$AUTO_UPDATES" == 'yes' ]] || return 0
	run_chroot pacman -S --noconfirm cambonos-upgrade
}

configure_pam_wheel() {
	local mount_point=${1:-$MOUNT_POINT}
	local pam_file
	for pam_file in su su-l; do
		local path="$mount_point/etc/pam.d/$pam_file"
		[[ -f "$path" ]] || fail "No se encuentra la configuración PAM $path."
		if grep -Eq '^[[:space:]]*auth[[:space:]]+required[[:space:]]+pam_wheel\.so[[:space:]]+use_uid([[:space:]]|$)' "$path"; then
			continue
		elif grep -Eq '^[[:space:]]*#[[:space:]]*auth[[:space:]]+required[[:space:]]+pam_wheel\.so[[:space:]]+use_uid([[:space:]]|$)' "$path"; then
			sed -E -i 's/^[[:space:]]*#[[:space:]]*(auth[[:space:]]+required[[:space:]]+pam_wheel\.so[[:space:]]+use_uid.*)$/\1/' "$path"
		elif [[ "$pam_file" == 'su-l' ]] && grep -Eq '^[[:space:]]*auth[[:space:]]+(include|substack)[[:space:]]+su([[:space:]]|$)' "$path"; then
			continue
		elif grep -Eq '^[[:space:]]*auth[[:space:]]+sufficient[[:space:]]+pam_rootok\.so([[:space:]]|$)' "$path"; then
			sed -E -i '/^[[:space:]]*auth[[:space:]]+sufficient[[:space:]]+pam_rootok\.so([[:space:]]|$)/a auth required pam_wheel.so use_uid' "$path"
		else
			fail "No se pudo aplicar la política wheel de forma segura en $path."
		fi
	done
}

configure_system_defaults() {
	local mount_point=${1:-$MOUNT_POINT}
	install -d "$mount_point/etc/default"
	printf "governor='performance'\n" > "$mount_point/etc/default/cpupower"
	run_chroot useradd -D -s /bin/zsh
	install -d -m 750 "$mount_point/etc/sudoers.d"
	cat > "$mount_point/etc/sudoers.d/cambonos-installer" <<'EOF'
%wheel ALL=(ALL) ALL
updates ALL=(ALL) NOPASSWD: /usr/bin/pacman
updates ALL=(ALL) NOPASSWD: /usr/bin/makepkg
EOF
	chmod 440 "$mount_point/etc/sudoers.d/cambonos-installer"
	configure_pam_wheel "$mount_point"
}

configure_system() {
	local -a services

	progress 42 'Configurando el sistema y activando servicios'
	if [[ -d /etc/NetworkManager/system-connections ]]; then
		install -d -m 700 "$MOUNT_POINT/etc/NetworkManager/system-connections"
		cp -a /etc/NetworkManager/system-connections/. "$MOUNT_POINT/etc/NetworkManager/system-connections/"
		find "$MOUNT_POINT/etc/NetworkManager/system-connections" -type f -exec chmod 600 {} +
		find "$MOUNT_POINT/etc/NetworkManager/system-connections" -type f -exec sed -i '/interface/d' {} +
	fi

	printf '%s\n' "$HOSTNAME" > "$MOUNT_POINT/etc/hostname"
	printf '127.0.0.1\tlocalhost\n::1\t\tlocalhost\n127.0.1.1\t%s\n' "$HOSTNAME" > "$MOUNT_POINT/etc/hosts"
	if [[ -f "$MOUNT_POINT/etc/systemd/resolved.conf" ]]; then
		sed -i 's/^#MulticastDNS=yes/MulticastDNS=no/' "$MOUNT_POINT/etc/systemd/resolved.conf"
	fi
	if [[ -f "$MOUNT_POINT/etc/avahi/avahi-daemon.conf" ]]; then
		sed -i 's/^use-ipv6=yes/use-ipv6=no/' "$MOUNT_POINT/etc/avahi/avahi-daemon.conf"
	fi

	run_chroot usermod -s /bin/zsh root
	run_chroot passwd --lock root
	run_chroot systemctl enable cpupower.service accounts-daemon.service NetworkManager.service ntpd.service systemd-resolved.service avahi-daemon.service systemd-homed.service
	configure_localization "$MOUNT_POINT"
	progress 43 'Preparando el usuario de mantenimiento y AUR'

	run_chroot groupadd --force updates
	if ! run_chroot id updates >/dev/null 2>&1; then
		run_chroot useradd -m -d /home/.updates -s /bin/bash -g updates updates
	fi
	run_chroot passwd --lock updates
	configure_system_defaults "$MOUNT_POINT"
	run_chroot visudo -c
	install_yay_and_optional_optimus_manager
	progress 54 "Instalando el entorno de escritorio: $DESKTOP"

	install_desktop
	progress 80 'Configurando el firewall'

	install -d "$MOUNT_POINT/etc/iptables"
	cat > "$MOUNT_POINT/etc/iptables/iptables.rules" <<'EOF'
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A INPUT -s 127.0.0.1 -j ACCEPT
-A INPUT -p udp --dport 5353 -j ACCEPT
COMMIT
EOF
	services=(iptables.service)
	if [[ "$INSTALL_SSH" == 'yes' ]]; then
		sed -i 's/^#X11Forwarding no/X11Forwarding yes/' "$MOUNT_POINT/etc/ssh/sshd_config"
		cat > "$MOUNT_POINT/etc/iptables/iptables.rules" <<'EOF'
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A INPUT -s 127.0.0.1 -j ACCEPT
-A INPUT -p tcp --dport 22 -m conntrack --ctstate NEW,ESTABLISHED -j ACCEPT
-A INPUT -p udp --dport 5353 -j ACCEPT
COMMIT
EOF
		services+=(sshd.service)
	fi
	run_chroot systemctl enable "${services[@]}"
	progress 85 'Creando el usuario y configurando idioma y zona horaria'

	run_chroot useradd -m -c "$ADMIN_NAME" -s /bin/zsh -g users -G wheel,rfkill,sys,lp "$ADMIN_USER"
	printf '%s:%s\n' "$ADMIN_USER" "$ADMIN_PASSWORD" | run_chroot chpasswd
	run_chroot chsh -s /usr/bin/nologin updates
	install_optional_upgrade_package
	progress 94 'Instalando GRUB y generando el menu de arranque'

	if [[ "$BOOT_MODE" == 'uefi' ]]; then
		run_chroot grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=CambonOS --no-nvram
	else
		run_chroot grub-install --target=i386-pc "$DISK"
	fi
	run_chroot grub-mkconfig -o /boot/grub/grub.cfg
	if [[ "$BOOT_MODE" == 'uefi' ]] && ! ensure_uefi_boot_entry; then
		: > "$WORK_DIR/uefi-entry-warning"
	fi
	progress 100 'Instalacion completada'
}

perform_installation() {
	progress 1 "Preparando las particiones en $DISK"
	create_partitions
	progress 3 'Formateando la particion raiz'
	mkfs.ext4 -F "$ROOT_PARTITION"
	if [[ "$BOOT_MODE" == 'uefi' ]]; then
		mkfs.vfat -F32 "$EFI_PARTITION"
	fi
	progress 5 'Montando el sistema de destino'
	mount "$ROOT_PARTITION" "$MOUNT_POINT"
	if [[ "$BOOT_MODE" == 'uefi' ]]; then
		install -d "$MOUNT_POINT/boot"
		mount "$EFI_PARTITION" "$MOUNT_POINT/boot"
	fi
	progress 8 'Particiones montadas; iniciando la instalacion base'

	install_base_system
	progress 38 'Creando el archivo de intercambio'
	fallocate -l 4G "$MOUNT_POINT/swapfile"
	chmod 600 "$MOUNT_POINT/swapfile"
	mkswap -U clear "$MOUNT_POINT/swapfile"
	swapon "$MOUNT_POINT/swapfile"
	genfstab -U "$MOUNT_POINT" >> "$MOUNT_POINT/etc/fstab"
	progress 41 'Configurando el sistema instalado'

	configure_system
}

run_installation() {
	local result=0
	WORK_DIR=$(mktemp -d /tmp/cambonos-installer.XXXXXX)
	mkfifo "$WORK_DIR/progress"
	(
		exec 3> "$WORK_DIR/progress"
		perform_installation
	) > "$WORK_DIR/install.log" 2>&1 &
	local worker=$!
	dialog --title "$TITLE" --gauge '\nInstalando CambonOS...' 7 76 0 < "$WORK_DIR/progress" || true
	wait "$worker" || result=$?
	if ((result != 0)); then
		KEEP_WORK_DIR=1
		show_error "La instalación falló. Registro completo: $WORK_DIR/install.log\n\n$(tail -n 12 "$WORK_DIR/install.log")"
		return "$result"
	fi
	if [[ -f "$WORK_DIR/uefi-entry-warning" ]]; then
		show_message 'La instalación ha finalizado, pero no se pudo verificar la entrada UEFI de CambonOS. Revise las entradas con efibootmgr antes de reiniciar.'
	else
		show_message 'La instalación de CambonOS ha finalizado correctamente. Puede reiniciar el equipo.'
	fi
}

main() {
	if (($#)); then
		case "$1" in
			-h|--help) usage; return 0 ;;
			*) usage >&2; return 2 ;;
		esac
	fi
	[[ $EUID -eq 0 ]] || fail 'Ejecute el instalador como root desde el sistema live.'
	require_commands dialog curl nmtui lsblk awk sed grep sort localectl parted partprobe udevadm mkfs.vfat mkfs.ext4 mount mountpoint umount timedatectl reflector pacman pacstrap arch-chroot genfstab mkswap swapon fallocate lspci systemctl install cp find chown chmod useradd groupadd passwd chsh visudo git makepkg grub-mkconfig
	[[ ! -e "$MOUNT_POINT" ]] || [[ -d "$MOUNT_POINT" ]] || fail "$MOUNT_POINT existe y no es un directorio."
	mountpoint -q "$MOUNT_POINT" && fail "$MOUNT_POINT ya está montado. Desmóntelo antes de iniciar el instalador."
	prepare_installer "$@" || return $?
	collect_options || return 0
	check_desktop_source
	check_optional_upgrade_package
	run_installation
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	trap cleanup EXIT
	main "$@"
fi